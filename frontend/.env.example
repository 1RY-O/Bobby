# Bobby frontend — environment template
#
# Copy to `.env.local` (git-ignored, highest precedence) and adjust:
#   cp frontend/.env.example frontend/.env.local
#
# `.env*` is git-ignored; this template is explicitly re-allowed so it stays
# committable. Never put a server-side secret in a NEXT_PUBLIC_* var — those
# are inlined into the client bundle and are public by definition.

# ---------------------------------------------------------------------------
# Server-side only (never exposed to the browser)
# ---------------------------------------------------------------------------
# Where the Next server proxies /api/* and /ws/* to reach FastAPI. This value
# stays inside next.config.ts, so no backend address is shipped to the client.
BACKEND_ORIGIN=http://localhost:8000

# ---------------------------------------------------------------------------
# Client-visible overrides (optional)
# ---------------------------------------------------------------------------
# The app talks same-origin by default: /api/start-workflow and
# /ws/agent-stream are proxied by Next, which is what keeps the bundle free of
# hardcoded backend hosts. Set these ONLY to bypass the proxy and hit a backend
# directly — doing so re-introduces a cross-origin request, so the backend's
# FRONTEND_ORIGINS must allow this page's origin, and if the backend is https
# you must use wss://.
#
# NEXT_PUBLIC_WORKFLOW_START_URL=/api/start-workflow
# NEXT_PUBLIC_AGENT_STREAM_URL=/ws/agent-stream

# ---------------------------------------------------------------------------
# Deployment note
# ---------------------------------------------------------------------------
# When self-hosting, serve the app over HTTPS: the CSP sent by next.config.ts
# includes Strict-Transport-Security, which browsers honour only on secure
# origins. If you terminate TLS at a proxy, forward X-Forwarded-Proto and set
# the backend's FRONTEND_ORIGINS to the public https origin.
