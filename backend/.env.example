# Bobby backend — environment template
#
# Copy to `.env` and adjust. Every value below is the real default baked into
# main.py, so an empty file behaves exactly like an unset one.
#
#   cp backend/.env.example backend/.env
#
# `.env*` is git-ignored (see the repo root .gitignore); this template is
# explicitly re-allowed so it stays committable.
#
# NOTE: main.py reads these with os.getenv() and does NOT load .env itself.
# Either export them in the process manager / container, or run under a loader:
#   uvicorn main:app --env-file backend/.env      # uv
#   python -m dotenv -f backend/.env main.py      # python-dotenv
#   set -a; . backend/.env; set +a                # plain POSIX shell

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# "production" (or "prod") disables /docs, /redoc and /openapi.json, turns off
# the uvicorn autoreloader and access log, and drops security headers that are
# meaningless over plain HTTP. Anything else is treated as development.
APP_ENV=development

# uvicorn bind. Defaults to 127.0.0.1 in production and 0.0.0.0 otherwise, so
# a prod instance is not accidentally exposed on all interfaces.
HOST=127.0.0.1
PORT=8000

# Autoreloader is force-disabled when APP_ENV=production regardless of this.
DEV_RELOAD=true

# ---------------------------------------------------------------------------
# CORS / WebSocket origin allowlist
# ---------------------------------------------------------------------------
# Comma-separated. The LAST value is served as Access-Control-Allow-Origin,
# so list the primary public origin last. Every entry must also be accepted by
# the WebSocket upgrade check in is_origin_allowed().
#
# THIS IS REQUIRED IN PRODUCTION. The fallback is the local dev server, which
# means a misconfigured deployment silently rejects its own users' browsers.
FRONTEND_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Rate limiting (per transport peer, fixed window)
# ---------------------------------------------------------------------------
# 5 requests / 60s by default. Clamped to 1..1000.
RATE_LIMIT_REQUESTS=5
# Clamped to 1..3600.
RATE_LIMIT_WINDOW_SECONDS=60
# Cap on tracked client buckets, so the in-memory table cannot grow without
# bound under a spoofed-IP flood. Clamped to 16..65536.
MAX_RATE_LIMIT_BUCKETS=1024

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
# Hard ceiling on the raw request body, enforced by BodySizeLimitMiddleware
# before parsing. Clamped to 4 KiB..8 MiB. A larger body returns HTTP 413.
MAX_REQUEST_BODY_BYTES=65536

# GZip floor in bytes. Responses below this size are sent uncompressed, which
# avoids the CPU cost of deflating tiny payloads. Clamped to 0..65536.
GZIP_MINIMUM_SIZE=1024

# How much of the graph's internal message transcript to echo in the HTTP
# response. 0 = no echo, which is the default and the recommended setting: the
# transcript embeds the caller's own issue text and grows every node, while the
# live narration already reaches the UI over the agent stream. Clamped 0..200.
MAX_ECHOED_MESSAGES=0

# Concurrent workflow runs admitted before further requests are rejected.
# Clamped to 1..64.
MAX_CONCURRENT_WORKFLOWS=4

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# There are deliberately none. The graph is deterministic, makes no LLM calls,
# and persists nothing, so this service holds no API keys or credentials.
# If you later add an LLM provider, put its key here — never in code — and
# remember that LangSmith/LangGraph tracing is off unless you ask for it:
#   LANGSMITH_TRACING=true
#   LANGCHAIN_TRACING_V2=true
#   LANGSMITH_API_KEY=sk-...
